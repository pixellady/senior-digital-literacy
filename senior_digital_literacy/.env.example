# Names only. Copy to .env in this folder (gitignored). Never commit values.
# Used by local uvicorn and by docker compose (env_file).

ANTHROPIC_API_KEY=
MODEL=anthropic/claude-sonnet-4-5-20250929

# Optional. Docker compose overrides HOST, CORS_ORIGIN, and tracing.
# CORS_ORIGIN=
# PORT=8000
# HOST=127.0.0.1
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_HOUR=40
# CREWAI_TRACING_ENABLED=false

# Unused for this slice. Do not treat as required.
# SERPER_API_KEY=
